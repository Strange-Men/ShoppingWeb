---
import Media from './Media.astro';
import { media, productCategories, site } from '../data/site';
const icons = [
  'M6 23l2-6L21 4l6 6-13 13-8 2z M19 6l6 6 M8 17l6 6 M5 11l6-6 4 4 M21 19l6 6-3 3-6-6',
  'M16 4l12 7-12 7-12-7 12-7z M4 16l12 7 12-7 M4 21l12 7 12-7',
  'M4 27V13l8 4v-7l8 4V5h6l2 22H4z M9 22h2m5 0h2m5 0h2',
  'M3 8h17v15H3z M20 13h5l4 5v5h-9 M7 23a3 3 0 1 0 6 0 M22 23a3 3 0 1 0 6 0',
];
const values = [site.foundedYear, `${site.workshopAreaSqm.toLocaleString('en-US')} m²`, productCategories.length];
import { localize } from "../i18n/content";
const { t, path, copy } = localize(Astro.url.pathname);
const { hero } = copy.home;
---
<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="hero-art">
    <Media image={media.hero} eager sizes="100vw" />
  </div>
  <div class="container hero-layout">
    <div class="hero-panel">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="home-hero-title">{hero.title[0]} <br />{hero.title[1]}</h1>
      <div class="gold-rule" aria-hidden="true"></div>
      <p class="hero-lead">{hero.text}</p>
      <ul class="hero-capabilities" aria-label={t("What we do", "服務內容")}>
        {hero.capabilities.map((label, index) => <li>
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[index]} /></svg>
          <span>{label}</span>
        </li>)}
      </ul>
      <dl class="hero-facts" aria-label={t("NanXuan at a glance", "楠軒概況")}>
        {hero.facts.map((label, index) => <div><dt>{label}</dt><dd>{values[index]}</dd></div>)}
      </dl>
      <p class="hero-signoff">{hero.notes.map((note) => <span>{note}</span>)}</p>
      <div class="button-row hero-actions">
        <a class="button button-gold" href={path("/en/contact/")}>{t("Get Quote", "洽詢報價")} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={path("/en/products/")}>{t("View Products", "瀏覽產品")} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero { position:relative; display:grid; align-items:center; isolation:isolate; min-block-size:max(620px,52vw); background:var(--paper); }
  .hero-art { position:absolute; inset:0; z-index:-1; margin:0; }
  .hero-art :global(.media-slot) { block-size:100%; aspect-ratio:auto; }
  .hero-art::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,#f7f6f2 0%,#f7f6f2f7 31%,#f7f6f2e8 46%,#f7f6f280 58%,transparent 72%); }
  .hero-layout { padding-block:clamp(42px,5vw,78px); }
  .hero-panel { inline-size:min(56%,640px); }
  .hero-panel .eyebrow { font-weight:600; }
  h1 { margin-block:16px 0; font:600 clamp(32px,3.7vw,62px)/1.04 var(--body); letter-spacing:-.045em; color:var(--navy); text-transform:uppercase; text-wrap:initial; }
  .gold-rule { margin-block:20px 16px; }
  .hero-lead { max-inline-size:49ch; font-size:clamp(15px,1.25vw,18px); line-height:1.65; color:#49484e; }
  .hero-capabilities, .hero-facts { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); padding:0; }
  .hero-capabilities { list-style:none; margin-block:25px 21px; }
  .hero-capabilities li { display:grid; align-content:start; justify-items:center; gap:8px; min-inline-size:0; padding:2px 8px 0; text-align:center; font:600 11px/1.4 var(--body); }
  .hero-capabilities li + li { border-inline-start:1px solid #bbb5a8; }
  .hero-capabilities svg { inline-size:30px; block-size:30px; color:var(--gold-dark); }
  .hero-facts { grid-template-columns:repeat(3,minmax(0,1fr)); margin:0; background:var(--navy); color:#fff; border-start-end-radius:14px; border-end-end-radius:14px; }
  .hero-facts > div { display:flex; flex-direction:column; gap:4px; padding:15px 12px; }
  .hero-facts > div + div { border-inline-start:1px solid #ffffff30; }
  .hero-facts dt { font:500 11px/1.35 var(--body); color:#e2dfeb; }
  .hero-facts dd { order:-1; margin:0; font:600 clamp(17px,1.65vw,26px)/1.16 var(--body); color:#e2c48b; white-space:nowrap; letter-spacing:-.025em; }
  .hero-signoff { display:flex; flex-wrap:wrap; align-items:center; gap:4px 14px; margin-block:15px 0; color:#49484e; font:600 10px/1.65 var(--body); letter-spacing:.07em; text-transform:uppercase; }
  .hero-signoff span + span::before { content:'•'; margin-inline-end:14px; color:var(--gold-dark); }
  .hero-actions { margin-block-start:22px; gap:10px 24px; }
  @media (max-width:899px) {
    .home-hero { min-block-size:0; }
    .hero-art { position:relative; aspect-ratio:16/9; }
    .hero-art::after { display:none; }
    .hero-layout { padding-block:32px 42px; }
    .hero-panel { inline-size:100%; }
    h1 { font-size:clamp(31px,6.2vw,55px); }
  }
  @media (max-width:479px) {
    .hero-capabilities { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .hero-capabilities { gap:15px 0; }
    .hero-capabilities li + li:nth-child(odd) { border-inline-start:0; }
    .hero-facts dd { font-size:18px; }
    .hero-actions .button { padding-inline:16px; gap:12px; }
    .hero-actions .text-link { gap:12px; }
  }
</style>
