---
import type { SculptureCase } from '../data/types';
import { equivalentCasePath } from '../i18n/routes';
import { localizedCase } from '../i18n/cases';
import Media from './Media.astro';
interface Props { item: SculptureCase }
const { item } = Astro.props;

import { localize } from "../i18n/content";
const { t, categories, chinese } = localize(Astro.url.pathname);
const translated = localizedCase(item, chinese);
---
<article class="case-card"><a class="case-card-link" href={equivalentCasePath(item, chinese ? 'zh-Hant' : 'en')!}>
  <div class="case-card-image"><Media image={translated.images[0]!} label={t("Photograph pending", "照片待補充")} />{item.status !== 'published' && <span class="preview-badge">{t("Preview · Unpublished", "預覽・尚未發布")}</span>}</div>
  <div class="case-card-copy"><span class="eyebrow">{categories.find(entry => entry.id === item.material)?.title}</span><h3>{translated.content.title}</h3><div class="case-card-bottom"><span>{item.status === 'preview' ? t('View layout', '查看版型') : t('View case', '查看案例')}</span><span class="round-arrow" aria-hidden="true">↗</span></div></div>
</a></article>
