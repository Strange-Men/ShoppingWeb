---
import type { MediaSlot } from '../data/types';
import Media from './Media.astro';
interface Props { images: MediaSlot[]; title: string }
const { images, title } = Astro.props;
import { localize } from "../i18n/content";
const { t } = localize(Astro.url.pathname);
---
<div class="gallery" data-gallery>
  <figure class="gallery-primary"><Media image={images[0]!} label={t("Case photograph pending", "案例照片待補充")} eager /><figcaption><span>{images[0]!.alt}</span><span>01 / {String(images.length).padStart(2,'0')}</span></figcaption></figure>
  <div class="gallery-thumbnails" aria-label={t("Case image views", "案例圖片")}>{images.map((image,index) => <button type="button" class="gallery-open" data-index={index} aria-label={t(`Open ${index + 1} of ${images.length}: ${image.alt}`, `開啟第 ${index + 1} 張（共 ${images.length} 張）：${image.alt}`)}><Media image={image} label={t(['Main view','Detail view','Context view'][index] || `View ${index + 1}`, ['主視圖','細節圖','場景圖'][index] || `圖片 ${index + 1}`)} /><span>{String(index + 1).padStart(2,'0')}</span></button>)}</div>
  <noscript><p class="small muted">{t("All image views", "全部圖片")}</p>{images.slice(1).map(image => <figure><Media image={image} /><figcaption>{image.alt}</figcaption></figure>)}</noscript>
  <dialog class="gallery-dialog" aria-label={t(`${title} image viewer`, `${title}圖片檢視器`)}>
    <div class="gallery-toolbar"><span class="eyebrow">{t("Image viewer","圖片檢視器")}</span><button class="icon-button gallery-close" type="button" aria-label={t("Close image viewer", "關閉圖片檢視器")}>×</button></div>
    <div class="gallery-slides">{images.map((image,index) => <figure data-slide={index} hidden={index !== 0}><Media image={image} label={t("Owner-supplied photograph pending", "照片待補充")} /><figcaption>{image.alt}</figcaption></figure>)}</div>
    <div class="gallery-controls"><button class="button button-outline gallery-prev" type="button" aria-label={t("Previous image", "上一張圖片")}>{t("← Previous", "← 上一張")}</button><span class="gallery-count" aria-live="polite">1 / {images.length}</span><button class="button button-outline gallery-next" type="button" aria-label={t("Next image", "下一張圖片")}>{t("Next →", "下一張 →")}</button></div>
  </dialog>
</div>
