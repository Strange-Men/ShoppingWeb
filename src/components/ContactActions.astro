---
import { site } from '../data/site';
import { inquiryLinks } from '../lib/inquiry';
interface Props { title?: string; path?: string }
const links = inquiryLinks(site.contacts, site.canonicalOrigin, Astro.props.title, Astro.props.path);
---
<div class="contact-actions">
  {links.whatsapp ? <a class="button button-gold" href={links.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">↗</span></a> : <span class="contact-pending"><strong>WhatsApp</strong><small>Account to be added</small></span>}
  {links.email ? <a class="button button-outline" href={links.email}>Send an email <span aria-hidden="true">↗</span></a> : <span class="contact-pending"><strong>Email</strong><small>Address to be added</small></span>}
</div>
