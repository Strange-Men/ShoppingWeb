---
import type { MediaSlot } from '../data/types';
interface Props { image: MediaSlot; label?: string; eager?: boolean; class?: string }
const { image, label = 'Owner-supplied image pending', eager = false, class: className = '' } = Astro.props;
---
<div class:list={['media-slot', className, { 'has-image': image.source }]} style={`--media-ratio:${image.width}/${image.height}`}>
  {image.source ? <img src={image.source} width={image.width} height={image.height} alt={image.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} /> :
    <div class="empty-media" role="img" aria-label={image.alt}>
      <span class="slot-corners" aria-hidden="true"></span>
      <span class="slot-caption"><span class="slot-mark" aria-hidden="true">＋</span>{label}</span>
    </div>}
</div>
