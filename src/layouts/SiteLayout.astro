---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { displayBrand, isPreview, site } from '../data/site';
import { publicOrigin } from '../lib/inquiry';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/playfair-display/latin-500.css';
import '../styles/global.css';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const origin = publicOrigin(site.canonicalOrigin);
const indexable = !isPreview && !noindex && !!origin;
---
<!doctype html><html lang="en" dir="ltr"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>{title} | {displayBrand}</title><meta name="description" content={description} /><meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} /><meta name="theme-color" content="#1a1a2e" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />{indexable && <link rel="canonical" href={new URL(Astro.url.pathname, origin!).href} />}<meta property="og:title" content={`${title} | ${displayBrand}`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /></head>
<body><a class="skip-link" href="#main">Skip to content</a>{isPreview && <div class="preview-bar"><span class="preview-dot" aria-hidden="true"></span>English layout preview <span class="preview-divider">/</span> Owner imagery & details pending</div>}<Header /><main id="main" tabindex="-1"><slot /></main><Footer /><script>import '../scripts/interactions';</script></body></html>
