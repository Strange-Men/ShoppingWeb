---
import { copy } from '../../i18n/en';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import ContactActions from '../../components/ContactActions.astro';
import { site } from '../../data/site';
import { socialUrl } from '../../lib/inquiry';
const socials = [{name:'Facebook',url:socialUrl(site.contacts.facebookUrl,'facebook')},{name:'Instagram',url:socialUrl(site.contacts.instagramUrl,'instagram')}];
const displayWhatsApp = site.contacts.whatsappDigits.startsWith('86') ? `+86 ${site.contacts.whatsappDigits.slice(2)}` : `+${site.contacts.whatsappDigits}`;
---
<SiteLayout title={copy.contact.title} description={copy.contact.description}>
  <PageHeading eyebrow={copy.contact.eyebrow} title={copy.contact.heading} description={copy.contact.lead} />
  <section class="section"><div class="container contact-grid"><div class="contact-panel"><p class="eyebrow">{copy.contact.panelEyebrow}</p><h2>{copy.contact.panelTitle}</h2><p>{copy.contact.panelText}</p><ContactActions />{!site.contacts.whatsappDigits && !site.contacts.email && <p class="preview-note">{copy.contact.pending}</p>}<dl class="contact-information"><div><dt>Company</dt><dd>{site.legalName || site.companyName}</dd></div>{site.contacts.whatsappDigits && <div><dt>WhatsApp</dt><dd><bdi>{displayWhatsApp}</bdi></dd></div>}{site.contacts.email && <div><dt>Email</dt><dd><bdi>{site.contacts.email}</bdi></dd></div>}<div><dt>Location</dt><dd>{site.address || 'Public address to be confirmed.'}</dd></div>{site.businessHours && <div><dt>Business hours</dt><dd>{site.businessHours}</dd></div>}</dl>{socials.some(item => item.url) && <div class="social-links">{socials.filter(item => item.url).map(item => <a href={item.url!} target="_blank" rel="noopener noreferrer">{item.name} ↗</a>)}</div>}</div><div class="brief-panel"><p class="eyebrow">{copy.contact.briefEyebrow}</p><h2>{copy.contact.briefTitle}</h2><ol><li><strong>{copy.contact.brief[0].title}</strong><p>{copy.contact.brief[0].text}</p></li><li><strong>{copy.contact.brief[1].title}</strong><p>{copy.contact.brief[1].text}</p></li><li><strong>{copy.contact.brief[2].title}</strong><p>{copy.contact.brief[2].text}</p></li><li><strong>{copy.contact.brief[3].title}</strong><p>{copy.contact.brief[3].text}</p></li></ol><p class="small muted">{copy.contact.scopeNote}</p></div></div></section>
</SiteLayout>
