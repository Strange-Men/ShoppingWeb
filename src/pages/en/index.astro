---
import { copy } from '../../i18n/en';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Media from '../../components/Media.astro';
import CaseCard from '../../components/CaseCard.astro';
import Inquiry from '../../components/Inquiry.astro';
import Process from '../../components/Process.astro';
import { media, materials, capabilities } from '../../data/site';
import { visibleCases } from '../../data/cases';
const featured = visibleCases().filter(item => item.featured);
---
<SiteLayout title={copy.home.title} description={copy.home.description}>
  <section class="hero" aria-label="Sculpture introduction"><div class="hero-media"><Media image={media.hero} label="Main sculpture photograph · awaiting your imagery" eager /></div><div class="container hero-content"><p class="eyebrow">{copy.home.heroEyebrow}</p><h1>{copy.home.heroTitle[0]}<br />{copy.home.heroTitle[1]}</h1><p>{copy.home.heroText[0]}<br class="desktop-break" /> {copy.home.heroText[1]}</p><div class="button-row"><a class="button button-gold" href="/en/products/">Explore our work <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="/en/contact/">Discuss your idea <span aria-hidden="true">→</span></a></div></div><div class="hero-foot"><div class="container"><span>{copy.home.heroNotes[0]}</span><span>{copy.home.heroNotes[1]}</span><span>{copy.home.heroNotes[2]}</span></div></div></section>
  <section class="section intro-section"><div class="container split-grid"><div><p class="eyebrow">{copy.home.introEyebrow}</p><h2>{copy.home.introTitle[0]}<br />{copy.home.introTitle[1]}</h2><div class="gold-rule"></div><p>{copy.home.intro[0]}</p><p>{copy.home.intro[1]}</p><a href="/en/about/" class="text-link">Discover our approach <span aria-hidden="true">↗</span></a></div><div class="intro-image"><Media image={media.workshop} label="Workshop photograph pending" /><span class="image-note">{copy.home.imageNote}</span></div></div></section>
  <section class="section featured-section"><div class="container"><div class="section-heading"><p class="eyebrow">{copy.home.featured.eyebrow}</p><h2>{copy.home.featured.title}</h2><p>{copy.home.featured.description}</p><div class="gold-rule"></div></div><p class="preview-note">{copy.home.featured.note}</p><div class="case-grid">{featured.map(item => <CaseCard item={item} />)}</div><div class="section-action"><a href="/en/products/" class="button button-outline">View all case layouts <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section materials-section"><div class="container"><div class="section-heading"><p class="eyebrow">{copy.home.materials.eyebrow}</p><h2>{copy.home.materials.title}</h2><p>{copy.home.materials.description}</p><div class="gold-rule"></div></div><div class="material-grid">{materials.map((material,index) => <a href={`/en/products/${material.id}/`} class="material-card"><Media image={media[material.id]} label="Material photograph pending" /><div class="material-card-body"><span class="eyebrow">0{index + 1} / Custom sculpture</span><h3>{material.title}</h3><p>{material.description}</p><span class="text-link">Explore material <span aria-hidden="true">↗</span></span></div></a>)}</div></div></section>
  <section class="section capabilities-section"><div class="container"><div class="section-heading"><p class="eyebrow">{copy.home.capabilities.eyebrow}</p><h2>{copy.home.capabilities.title}</h2><p>{copy.home.capabilities.description}</p><div class="gold-rule"></div></div><div class="capability-grid">{capabilities.map(item => <article><span class="capability-number">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <Process /><Inquiry />
</SiteLayout>
