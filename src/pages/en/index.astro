---
import { copy } from '../../i18n/en';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCategoryGrid from '../../components/ProductCategoryGrid.astro';
import SculptureGallery from '../../components/SculptureGallery.astro';
import Inquiry from '../../components/Inquiry.astro';
import Process from '../../components/Process.astro';
import HomeHero from '../../components/HomeHero.astro';
import { media, productCategories, capabilities, site } from '../../data/site';
import { presentationImages } from '../../data/photography';
const gallery = productCategories.flatMap(({ id }) => presentationImages(id)
  .filter(item => item.image.source !== media[id].source && item.image.source !== media.hero.source)
  .slice(0, 2));
---
<SiteLayout title={copy.home.title} description={copy.home.description}>
  <HomeHero />
  <section class="section intro-section">
    <div class="container section-heading">
      <h2>About NanXuan</h2>
      <p>Established in {site.foundedYear}, {site.legalName} manufactures custom sculptures and display props, with an approximately {site.workshopAreaSqm.toLocaleString('en-US')} m² workshop in Zhaoqing, Guangdong, China.</p>
      <a href="/en/about/" class="text-link">About Us <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="section featured-section">
    <div class="container">
      <div class="section-heading"><h2>{copy.home.featured}</h2><div class="gold-rule"></div></div>
      <nav class="material-tabs featured-categories" aria-label="Browse featured product categories">
        {productCategories.map(category => <a href={`/en/products/${category.id}/`}>{category.title}</a>)}
      </nav>
      <SculptureGallery items={gallery} threeColumns />
      <div class="section-action"><a href="/en/products/" class="button button-outline">View All Products <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="section materials-section">
    <div class="container">
      <div class="section-heading"><h2>{copy.home.materials}</h2><div class="gold-rule"></div></div>
      <ProductCategoryGrid />
    </div>
  </section>
  <section class="section capabilities-section">
    <div class="container">
      <div class="section-heading"><h2>{copy.home.capabilities}</h2><div class="gold-rule"></div></div>
      <div class="capability-grid">
        {capabilities.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>
  <Process /><Inquiry />
</SiteLayout>

<style>
  .intro-section .section-heading { margin-block-end:0; }
  .intro-section .text-link { margin-block-start:16px; }
  .featured-categories { justify-content:center; margin-block-end:24px; }
</style>
