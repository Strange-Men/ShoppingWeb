---
import { copy } from '../../i18n/en';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Media from '../../components/Media.astro';
import Process from '../../components/Process.astro';
import Inquiry from '../../components/Inquiry.astro';
import { media, site } from '../../data/site';
---
<SiteLayout title={copy.about.title} description={copy.about.description}>
  <PageHeading eyebrow={copy.about.eyebrow} title={copy.about.heading} description={copy.about.lead} />
  <section class="section"><div class="container split-grid"><Media image={media.workshop} label="Your workshop photograph goes here" eager /><div><p class="eyebrow">楠轩雕塑</p><h2>{copy.about.introTitle[0]}<br />{copy.about.introTitle[1]}</h2><div class="gold-rule"></div><p>{copy.about.paragraphs[0]}</p><p>{copy.about.paragraphs[1]}</p>{site.profile ? <p>{site.profile}</p> : <div class="content-pending"><span class="eyebrow">Company profile pending</span><p>{copy.about.pending}</p></div>}</div></div></section>
  <Process /><Inquiry />
</SiteLayout>
