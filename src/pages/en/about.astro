---
import { copy } from '../../i18n/en';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Media from '../../components/Media.astro';
import Process from '../../components/Process.astro';
import Inquiry from '../../components/Inquiry.astro';
import { media, site, companyFacts, materialProcesses } from '../../data/site';
---
<SiteLayout title={copy.about.title} description={copy.about.description}>
  <PageHeading eyebrow={copy.about.eyebrow} title={copy.about.heading} description={copy.about.lead} />
  <section class="company-facts" aria-label="Company facts"><div class="container company-facts-grid">{companyFacts.map(fact => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}</div></section>
  <section class="section">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">{site.legalName}</p><h2>{copy.about.introTitle}</h2><div class="gold-rule"></div>
        {site.profile ? <p>{site.profile}</p> : <p class="content-pending">{copy.about.pending}</p>}
        <a class="text-link" href="/en/products/">View Products <span aria-hidden="true">↗</span></a>
      </div>
      <figure>
        <h2>Our Workshop</h2>
        <Media image={media.workshop} />
        <figcaption class="small muted">Model-making equipment in our Zhaoqing workshop.</figcaption>
      </figure>
    </div>
  </section>
  <section class="section material-processes"><div class="container"><div class="section-heading"><h2>Materials and Craftsmanship</h2></div><div class="material-process-grid">{materialProcesses.map(process => <article><p class="eyebrow">{process.material}</p><h3>{process.title}</h3><p>{process.text}</p></article>)}</div></div></section>
  <Process /><Inquiry />
</SiteLayout>
