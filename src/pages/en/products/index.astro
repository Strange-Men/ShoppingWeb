---
import { copy } from '../../../i18n/en';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHeading from '../../../components/PageHeading.astro';
import CaseCard from '../../../components/CaseCard.astro';
import Inquiry from '../../../components/Inquiry.astro';
import { visibleCases } from '../../../data/cases';
import { materials, isPreview } from '../../../data/site';
---
<SiteLayout title={copy.work.title} description={copy.work.description}>
  <PageHeading eyebrow={copy.work.eyebrow} title={copy.work.heading} description={copy.work.lead} />
  <section class="section listing-section"><div class="container"><nav class="material-tabs" aria-label="Browse by material"><a href="/en/products/" aria-current="page">All work</a>{materials.map(material => <a href={`/en/products/${material.id}/`}>{material.title}</a>)}</nav><div class="listing-meta"><p>{isPreview ? copy.work.note : `${visibleCases().length} cases`}</p><span>Made to order</span></div><div class="case-grid">{visibleCases().map(item => <CaseCard item={item} />)}</div>{!visibleCases().length && <p class="content-pending">{copy.work.empty}</p>}</div></section><Inquiry />
</SiteLayout>
