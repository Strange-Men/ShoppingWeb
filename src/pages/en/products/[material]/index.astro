---
import { copy } from '../../../../i18n/en';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import PageHeading from '../../../../components/PageHeading.astro';
import CaseCard from '../../../../components/CaseCard.astro';
import Inquiry from '../../../../components/Inquiry.astro';
import { materials, isPreview } from '../../../../data/site';
import { visibleCases } from '../../../../data/cases';
export function getStaticPaths() { return materials.map(material => ({params:{material:material.id},props:{material}})); }
const { material } = Astro.props;
const items = visibleCases().filter(item => item.material === material.id);
---
<SiteLayout title={`${material.title} sculpture cases`} description={`Explore ${material.title.toLowerCase()} sculpture layouts and custom project information. Photographs and verified case details are pending.`}>
  <PageHeading eyebrow="Custom sculpture / Materials" title={`${material.title} sculptures`} description={material.description} />
  <section class="section listing-section"><div class="container"><nav class="material-tabs" aria-label="Browse by material"><a href="/en/products/">All work</a>{materials.map(entry => <a href={`/en/products/${entry.id}/`} aria-current={entry.id === material.id ? 'page' : undefined}>{entry.title}</a>)}</nav><div class="listing-meta"><p>{items.length} {isPreview ? 'unpublished preview slots · photographs & details pending' : 'cases'}</p><a href="/en/contact/" class="text-link">Discuss this material ↗</a></div><div class="case-grid">{items.map(item => <CaseCard item={item} />)}</div>{!items.length && <p class="content-pending">Approved cases for this material will be added here.</p>}<div class="material-note"><h2>{copy.work.materialNoteTitle}</h2><p>{copy.work.materialNote}</p></div></div></section><Inquiry />
</SiteLayout>
