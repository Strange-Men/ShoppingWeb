---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import Media from '../../components/Media.astro';
import Process from '../../components/Process.astro';
import Inquiry from '../../components/Inquiry.astro';
import WorkshopGallery from '../../components/WorkshopGallery.astro';
import { media } from '../../data/site';
import { localize } from "../../i18n/content";
import { localizedRoutes } from '../../i18n/routes';

const { t, path, copy, company } = localize(Astro.url.pathname);
export const getStaticPaths = localizedRoutes;
---
<SiteLayout title={copy.about.title} description={copy.about.description}>
  <PageHeading eyebrow={copy.about.eyebrow} title={copy.about.heading} description={copy.about.lead} />
  <section class="company-facts" aria-label={t("Company facts", "公司概況")}><div class="container company-facts-grid">{company.facts.map(fact => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}</div></section>
  <section class="section">
    <div class="container split-grid">
      <div>
        <p class="eyebrow">{company.legalName}</p><h2>{copy.about.introTitle}</h2><div class="gold-rule"></div>
        {company.profile ? <p>{company.profile}</p> : <p class="content-pending">{copy.about.pending}</p>}
        <div class="button-row">
          <a class="text-link" href="#our-workshop">{t("See Our Workshop", "參觀車間")} <span aria-hidden="true">↓</span></a>
          <a class="text-link" href={path("/en/products/")}>{t("View Products", "瀏覽產品")} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <figure>
        <Media image={media.workshop} />
        <figcaption class="small muted">{t("Model-making equipment in our Zhaoqing workshop.", "肇慶車間的模型製作設備。")}</figcaption>
      </figure>
    </div>
  </section>
  <WorkshopGallery />
  <section class="section material-processes"><div class="container"><div class="section-heading"><h2>{t("Materials and Craftsmanship", "材料與工藝")}</h2></div><div class="material-process-grid">{company.materials.map(process => <article><p class="eyebrow">{process.material}</p><h3>{process.title}</h3><p>{process.text}</p></article>)}</div></div></section>
  <Process /><Inquiry />
</SiteLayout>
