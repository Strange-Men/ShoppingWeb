---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProductCategoryGrid from '../../components/ProductCategoryGrid.astro';
import SculptureGallery from '../../components/SculptureGallery.astro';
import Inquiry from '../../components/Inquiry.astro';
import Process from '../../components/Process.astro';
import HomeHero from '../../components/HomeHero.astro';
import { site } from '../../data/site';
import { homepageProducts } from '../../data/photography';
import { localize } from "../../i18n/content";
import { localizedRoutes } from '../../i18n/routes';

const { t, path, copy, categories, company } = localize(Astro.url.pathname);
const gallery = homepageProducts();
export const getStaticPaths = localizedRoutes;
---
<SiteLayout title={copy.home.title} description={copy.home.description}>
  <HomeHero />
  <section class="section intro-section">
    <div class="container section-heading">
      <h2>{t("About NanXuan", "關於楠軒")}</h2>
      <p>{t(`Established in ${site.foundedYear}, ${site.legalName} manufactures custom sculptures and display props, with an approximately ${site.workshopAreaSqm.toLocaleString('en-US')} m² workshop in Zhaoqing, Guangdong, China.`, `楠軒成立於 ${site.foundedYear} 年，製作客製雕塑與展示道具，在中國廣東肇慶設有約 ${site.workshopAreaSqm.toLocaleString('zh-Hant')} 平方公尺的車間。`)}</p>
      <a href={path("/en/about/")} class="text-link">{t("About Us", "關於我們")} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="section featured-section">
    <div class="container">
      <div class="section-heading"><h2>{copy.home.featured}</h2><div class="gold-rule"></div></div>
      <nav class="material-tabs featured-categories" aria-label={t("Browse featured product categories", "瀏覽精選產品分類")}>
        {categories.map(category => <a href={path(`/en/products/${category.id}/`)}>{category.title}</a>)}
      </nav>
      <div class="featured-rows">
        {gallery.map(items => <SculptureGallery items={items} threeColumns sizes="(max-width: 599px) calc(100vw - 36px), (max-width: 1264px) 33vw, 400px" />)}
      </div>
      <div class="section-action"><a href={path("/en/products/")} class="button button-outline">{t("View All Products", "瀏覽全部產品")} <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
  <section class="section materials-section">
    <div class="container">
      <div class="section-heading"><h2>{copy.home.materials}</h2><div class="gold-rule"></div></div>
      <ProductCategoryGrid home />
    </div>
  </section>
  <section class="section capabilities-section">
    <div class="container">
      <div class="section-heading"><h2>{copy.home.capabilities}</h2><div class="gold-rule"></div></div>
      <div class="capability-grid">
        {company.capabilities.map(item => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>
  <Process /><Inquiry />
</SiteLayout>

<style>
  .intro-section .section-heading { margin-block-end:0; }
  .intro-section .text-link { margin-block-start:16px; }
  .featured-categories { justify-content:center; margin-block-end:24px; }
  .featured-rows { display:grid; gap:24px; }
  @media (min-width:600px) {
    .featured-rows :global(.sculpture-grid-three) { grid-template-columns:repeat(3,minmax(0,1fr)); }
  }
  @media (max-width:599px) {
    .featured-rows { gap:16px; }
    .featured-rows :global(.sculpture-grid-three) { grid-template-columns:1fr; gap:16px; }
  }
</style>
