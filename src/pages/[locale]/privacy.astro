---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { localize } from "../../i18n/content";
import { localizedRoutes } from '../../i18n/routes';
export const getStaticPaths = localizedRoutes;
const { t, path } = localize(Astro.url.pathname);
---
<SiteLayout title={t("Privacy notice for this preview", "網站預覽隱私聲明")} description={t("This preview has no inquiry form, account system, analytics SDK or online transactions. Learn what happens when following an external contact link.", "本預覽網站的隱私聲明，以及使用外部聯絡連結時的說明。")}>
<PageHeading eyebrow={t("Privacy notice", "隱私聲明")} title={t("A simple, direct connection.", "網站與聯絡方式的隱私說明")} description={t("Design preview · 5 November 2026", "網站預覽・2026 年 11 月 5 日")} /><section class="section"><div class="container narrow prose"><h2>{t("This website","本網站")}</h2><p>{t("This static preview has no account system, inquiry form, file upload or business database. It does not include analytics, advertising SDKs or tracking cookies. Fonts are served locally.", "本靜態預覽網站未設帳號、詢價表單、檔案上傳或業務資料庫，也未加入流量分析、廣告 SDK 或追蹤 Cookie。字型由本站提供。")}</p><h2>{t("External contact channels", "外部聯絡方式")}</h2><p>{t("WhatsApp and any configured social links open third-party services, which apply their own privacy terms. Email links open Gmail or your email application. Opening a link does not automatically send a message.", "WhatsApp 與社群連結會開啟第三方服務，適用各服務的隱私條款。電子郵件連結會開啟 Gmail 或您的郵件應用程式。開啟連結時，系統不會自動傳送訊息。")}</p><p>{t("You choose what to share with us. This review preview is hosted on Netlify and OpenAI Sites. Hosting providers may process technical connection and usage data under their own privacy policies. See the ", "您可以自行決定要分享的資訊。本預覽網站由 Netlify 與 OpenAI Sites 託管，服務供應商可能依其隱私政策處理連線與使用資料。請參閱")}<a href="https://openai.com/policies/privacy-policy/" target="_blank" rel="noopener noreferrer">{t("OpenAI privacy policy", "OpenAI 隱私政策")}</a>{t(" and the ", "及")}<a href="https://www.netlify.com/privacy/" target="_blank" rel="noopener noreferrer">{t("Netlify privacy policy", "Netlify 隱私政策")}</a>{t(". This website does not add inquiry tracking or an analytics SDK.", "。本網站未加入詢價追蹤或流量分析 SDK。")}</p><h2>{t("Notice status", "聲明適用範圍")}</h2><p>{t("NanXuan’s contact details are available on the contact page. The company is Shenzhen Nanxuan Crafts Co., Ltd., based in Shenzhen with a workshop in Zhaoqing, Guangdong, China. The hosting and access-log arrangements for the future formal company website remain to be confirmed. This notice must be reviewed with the final service setup before launch.", "楠軒的聯絡方式請見聯絡頁。深圳市楠軒工藝品有限公司位於深圳，車間位於中國廣東肇慶。正式網站的託管與存取紀錄安排仍待確認，本聲明將於正式上線前依實際服務設定複核。")}</p><a class="text-link" href={path("/en/contact/")}>{t("Contact information", "聯絡資訊")} ↗</a></div></section>
</SiteLayout>
